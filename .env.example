# Environment Configuration
ENVIRONMENT=development
DEBUG=True

# Application
APP_NAME="FraudGuard AI"
API_V1_STR="/api"

# Security & Authentication
# In production, set to a strong 32+ character random string
JWT_SECRET_KEY=your-production-jwt-secret-key-32-chars-minimum
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Database Configuration
# Default (Development): Local SQLite database
DATABASE_URL=sqlite:///./fraudguard.db
# Production (PostgreSQL):
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/fraudguard

# Distributed Queue & Cache (Redis & Celery)
REDIS_URL=redis://localhost:6379/0

# Generative AI Analyst Assistant (Google Gemini)
# Obtain your key from: https://aistudio.google.com/
# Leave empty to run in deterministic grounded fallback mode
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# ML & File Storage
MODEL_DIRECTORY=ml/artifacts
UPLOAD_DIRECTORY=uploads
MAX_UPLOAD_SIZE_MB=50

# Risk Engine Thresholds (Configurable)
DEFAULT_RISK_THRESHOLD=0.50
HIGH_RISK_THRESHOLD=0.75
CRITICAL_RISK_THRESHOLD=0.90

# Rate Limiting (per minute)
RATE_LIMIT_LOGIN_PER_MIN=15
RATE_LIMIT_PREDICT_PER_MIN=120
RATE_LIMIT_COPILOT_PER_MIN=30
RATE_LIMIT_BATCH_PER_MIN=10

# CORS Allowed Origins (Comma-separated or JSON list; no '*' in production)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
